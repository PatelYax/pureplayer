{
  "expo": {
    "name": "PurePlayer",
    "slug": "pureplayer",
    "version": "0.1.4",
    "versionCode": 5,
    "platforms": [
      "android"
    ],
    "orientation": "default",
    "icon": ".\\assets\\icon.png",
    "android": {
      "package": "com.pureplayer.app",
      "adaptiveIcon": {
        "foregroundImage": ".\\assets\\adaptive-icon.png",
        "backgroundColor": "#071425"
      }
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": ".\\assets\\tv-banner.png"
        }
      ],
      "expo-video",
      [
        "react-native-google-cast",
        {
          "androidPlayServicesCastFrameworkVersion": "22.2.0"
        }
      ],
      "./plugins/withHttpPlayback",
      [
        "./plugins/withCmakeVersion",
        {
          "version": "4.1.2"
        }
      ]
    ]
  }
}