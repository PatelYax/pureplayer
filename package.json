{
  "name": "pureplayer",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-expo-video.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-video"]
      }
    }
  },
  "dependencies": {
    "@react-native-tvos/config-tv": "0.1.7",
    "expo": "~58.0.26",
    "expo-brightness": "~58.0.3",
    "expo-document-picker": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-video": "58.0.14",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
